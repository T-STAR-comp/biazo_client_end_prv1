# Optional layout: document root = project folder containing dist/
# Prefer uploading cpanel-upload/ contents directly to public_html instead.
Options -Indexes

DirectoryIndex dist/index.html

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

RewriteEngine On
RewriteBase /

RewriteRule ^api/ - [END]

RewriteRule ^src/ - [F,L]
RewriteRule ^index\.vite\.html$ - [F,L]

RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.+)$ dist/$1 [L]

RewriteRule ^ dist/index.html [L]
