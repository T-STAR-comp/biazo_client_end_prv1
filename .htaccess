# Static hosting: document root is the client-end folder (not dist/).
# Sends all traffic to the Vite build in dist/
Options -Indexes

DirectoryIndex dist/index.html

RewriteEngine On
RewriteBase /

# Optional: proxy /api to the Node backend on the same server.
# Uncomment and set YOUR_NODE_PORT (cPanel → Setup Node.js App → see port).
# Requires LiteSpeed/Apache mod_proxy.
# RewriteRule ^api/(.*)$ http://127.0.0.1:YOUR_NODE_PORT/api/$1 [P,L]

# Never send API requests to the SPA (avoids HTML responses for POST /api/...)
RewriteRule ^api/ - [END]

# Always use the production shell from dist/ (ignore stray root index.html)
RewriteRule ^index\.html$ dist/index.html [L]

# Block dev sources if the full repo was uploaded by mistake
RewriteRule ^src/ - [F,L]

# Serve built assets and files from dist/ when they exist
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.+)$ dist/$1 [L]

# SPA fallback (/, /dashboard, /auth, etc.)
RewriteRule ^ dist/index.html [L]
